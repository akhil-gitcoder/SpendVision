# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_dashboard

# --- AI provider configuration ---
# Which LLM provider to use. Supported: "groq" | "gemini" | "anthropic" | "mock"
# "mock" (or a blank AI_API_KEY) needs no key and uses deterministic
# template/keyword fallbacks, so the app runs out of the box without AI.
# "groq" is free (no credit card) and very fast - get a key at https://console.groq.com/keys
# "gemini" is free (no credit card) but its free tier can be slow or
#   overloaded at busy times - get a key at https://aistudio.google.com/apikey
# "anthropic" is paid pay-as-you-go - get a key at https://console.anthropic.com
AI_PROVIDER=groq

# API key for the chosen provider. Leave blank to fall back to "mock" behavior.
AI_API_KEY=

# Model name passed to the provider.
# groq: openai/gpt-oss-20b (fast) or openai/gpt-oss-120b (smarter, slower).
#   Free plan: ~30 requests/min, 1,000/day.
# gemini: gemini-3.5-flash-lite - the free tier's generous "lite" model.
#   Avoid "-latest" aliases and flagship models (e.g. gemini-3.7-flash) on the
#   free tier: their free quota can be as low as ~20 requests/day. Google
#   retires models often; if this one 404s, the error names its replacement.
# anthropic: claude-3-5-haiku-20241022
AI_MODEL=openai/gpt-oss-20b

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Environment name (development | production) - affects error verbosity.
ENVIRONMENT=development
